#!/bin/bash
# Nightly video-security run, called by cron at 23:00 (bounded to 3h).
VAR="/Users/ryan/.local/opt/video-security/var"
LOG_DIR="$VAR/logs"
mkdir -p "$LOG_DIR"
touch "$LOG_DIR/.metadata_never_index"
LOG="$LOG_DIR/run-$(date +%Y%m%d).log"
exec >> "$LOG" 2>&1
echo "=== $(date '+%Y-%m-%d %H:%M:%S') video-security-nightly (stop-after ${1:-3h}) ==="
if pgrep -f '[v]s run --source' >/dev/null 2>&1; then
    echo "previous run still alive; stopping it first"
    pkill -INT -f '[v]s run --source'
    for _ in $(seq 1 30); do
        pgrep -f '[v]s run --source' >/dev/null 2>&1 || break
        sleep 2
    done
    pkill -KILL -f '[v]s run --source' 2>/dev/null
    sleep 1
    echo "previous run stopped"
fi
find "$LOG_DIR" -name 'run-*.log' -mtime +14 -delete
exec /Users/ryan/.local/bin/vs run \
    --source /Volumes/CX-8 \
    --phases 1,2,3 \
    --stop-after "${1:-3h}" \
    --resume
